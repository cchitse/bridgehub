# Set a real operator contact before running a live SEC lookup.
SEC_CONTACT_EMAIL=

# Required for production; leave both empty for single-process local development.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# All instances of the same deployment must use the same namespace.
BRIDGEHUB_STATE_NAMESPACE=bridgehub:v1

# Website tutorial only: set to the verified HTTPS public origin after publication.
# Rebuild after changing. Leave empty while the public endpoint is unpublished.
BRIDGEHUB_PUBLIC_ORIGIN=

# MCP host/origin validation: actual HTTPS production origin, without /api/mcp.
BRIDGEHUB_ORIGIN=
